# Copy to local.env; this file is never shell-sourced by the portable tools.
# Real addresses, private paths and keys belong only in local.env (JSON).
# A future native adapter reads explicitly whitelisted fields.
{
  "source_dir": "REPLACE_WITH_OWN_RELEASE_COPY",
  "work_dir": "REPLACE_WITH_OWN_HEAVY_DIRECTORY",
  "guest_host": "REPLACE_WITH_LOCAL_TRANSPORT_ENDPOINT",
  "guest_port": 0,
  "guest_user": "person",
  "ssh_key": "REPLACE_WITH_TEST_KEY",
  "known_hosts": "REPLACE_WITH_TEST_KNOWN_HOSTS",
  "slot_file": "REPLACE_WITH_OWN_ACQUIRED_SLOT",
  "interface_sha256": "UNBOUND",
  "release": "UNBOUND"
}
