   "debugger rc": {
    "note": "",
    "steps": {
     "attempt": {
      "command": "cd @TARGET@ && printf \"%s\\n\" \"import os; open(os.environ['CASE_MARKER'], 'w').write('executed')\" > .pdbrc && printf \"c\\n\" | python3 -m pdb /usr/lib/python3.13/this.py >/dev/null",
