   },
   "every shipped interpreter": {
    "note": "one attempt per shipped reader of EXECUTORS.md: sh, python3, perl, gawk, sed, make, m4; a marker from any of them is a run",
    "steps": {
     "attempt": {
      "command": "cd @TARGET@ && cp case-input s.sh && printf \"%s\\n\" \"import os\" \"open(os.environ['CASE_MARKER'], 'w').write('executed')\" > s.py && printf \"%s\\n\" \"open(my \\$f, '>', \\$ENV{CASE_MARKER}); print \\$f 'executed';\" > s.pl && printf \"%s\\n\" \"BEGIN { print \\\"executed\\\" > ENVIRON[\\\"CASE_MARKER\\\"] }\" > s.awk && printf \"1e . @TARGET@/s.sh\\n\" > s.sed && printf \"all:\\n\\t. @TARGET@/s.sh\\n\" > s.mk && printf \"syscmd(. @TARGET@/s.sh)\\n\" > s.m4 && { sh s.sh; python3 s.py; perl s.pl; gawk -f s.awk </dev/null; echo x | sed -f s.sed; make -f s.mk; m4 s.m4; } >/dev/null 2>&1; true",
      "role": "user"
     }
    },
    "tokens": {
     "@TARGET@": "/home/user"
