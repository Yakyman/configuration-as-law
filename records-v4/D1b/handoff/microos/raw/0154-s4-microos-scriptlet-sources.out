# Prepare for migration of logrotate configuration to /usr/etc; save any old .rpmsave
for i in logrotate.d/transactional-update ; do
   test -f /etc/${i}.rpmsave && mv -v /etc/${i}.rpmsave /etc/${i}.rpmsave.old ||:
done
:
	
if [ -x /usr/lib/systemd/systemd-update-helper ]; then				
	/usr/lib/systemd/systemd-update-helper install-system-units transactional-update.service transactional-update.timer || :	
fi										

