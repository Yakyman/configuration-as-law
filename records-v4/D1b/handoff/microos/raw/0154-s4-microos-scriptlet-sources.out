"/^[^#]*LOADER_TYPE=/{s@.*=\(.*\)@\1@;s@^[\"']@@;s@[\"']\\$@@;p;q}" \
/etc/sysconfig/bootloader \
2>/dev/null || :` 
for bl in grub2-efi; do 
