systemd-presets-common-SUSE

# On initial installation, branding-preset-states does not yet exist, 
# which is why we also check for the file to be present/executable 
if [ $1 -gt 1 -a -x /usr/lib/systemd-presets-branding/branding-preset-states ] ; then 
	# 
	# Save the old state so we can detect which package have its 
	# default changed later. 
	# 
	# Note: the old version of the script is used here. 
	# 
	/usr/lib/systemd-presets-branding/branding-preset-states save 
elif [ $1 -eq 1 ]; then 
  touch /run/rpm-systemd-presets-branding-preset-system 
fi 


# On initial installation, branding-preset-states does not yet exist, 
# which is why we also check for the file to be present/executable 
if [ $1 -gt 1 -a -x /usr/lib/systemd-presets-branding/branding-preset-states ] ; then 
	# 
	# Save the old state so we can detect which package have its 
	# default changed later. 
	# 
	# Note: the old version of the script is used here. 
	# 
	/usr/lib/systemd-presets-branding/branding-preset-states save user 
elif [ $1 -eq 1 ]; then 
  touch /run/rpm-systemd-presets-branding-preset-user 
fi

if [ $1 -gt 1 ] ; then 
	# 
	# Now that the updated presets are installed, find the ones 
	# that have been changed and apply "systemct preset" on them. 
	# 
	/usr/lib/systemd-presets-branding/branding-preset-states apply-changes 
fi 


if [ $1 -gt 1 ] ; then 
	# 
	# Now that the updated presets are installed, find the ones 
	# that have been changed and apply "systemct preset" on them. 
	# 
	/usr/lib/systemd-presets-branding/branding-preset-states apply-changes user 
fi
