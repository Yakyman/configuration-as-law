	    touch /etc/sysconfig/$SD_NAME$PNAME 
	    /bin/fillup -q /etc/sysconfig/$SD_NAME$PNAME $SYSC_TEMPLATE 
	fi 
    else 
	echo "ERROR: fillup not found. This should not happen. Please compare" 
	echo "/etc/sysconfig/$PNAME and $TEMPLATE_DIR/sysconfig.$PNAME and" 
	echo "update by hand." 
    fi
audit-rules

	
if [ -x /usr/lib/systemd/systemd-update-helper ]; then				
	/usr/lib/systemd/systemd-update-helper mark-install-system-units audit-rules.service || : 
fi
if [ -f /etc/audit.rules ]; then
   # If /etc/audit.rules exists, move into the expected default place /etc/audit/audit.rules.
   mv /etc/audit.rules /etc/audit/audit.rules
else
   # We only expect /etc/audit/audit.rules to exist.  If it doesn't, augenrules --load will create
   # it with the rules in /etc/audit/rules.d.
   #
   # If /etc/audit/rules.d is empty, copy the default rules file (no-rules).
   files=`ls /etc/audit/rules.d/ 2>/dev/null | wc -w`
   if [ "$files" -eq 0 ] ; then
      touch /etc/audit/audit.rules
      install -m 0600 /usr/share/audit-rules/10-no-audit.rules /etc/audit/rules.d/audit.rules
      # Make the new rules active
   fi
   augenrules --load
fi

	
if [ -x /usr/lib/systemd/systemd-update-helper ]; then				
	/usr/lib/systemd/systemd-update-helper install-system-units audit-rules.service || :	
fi
