[
  "qemu-system-x86_64",
  "-enable-kvm",
  "-m",
  "4096",
  "-smp",
  "2",
  "-display",
  "none",
  "-monitor",
  "none",
  "-serial",
  "file:[stand-root]/vms/bc4-second-4-single/console.log",
  "-drive",
  "file=[stand-root]/vms/bc4-second-4-single/disk.qcow2,format=qcow2,if=virtio",
  "-netdev",
  "user,id=net0,hostfwd=tcp:127.0.0.1:60337-:22",
  "-device",
  "virtio-net-pci,netdev=net0,mac=<MAC>",
  "-qmp",
  "unix:[stand-root]/vms/bc4-second-4-single/qmp.sock,server=on,wait=off",
  "-pidfile",
  "[stand-root]/vms/bc4-second-4-single/qemu.pid"
]
