profile confos-flatpak flags=(attach_disconnected,mediate_deleted) {
  capability chown,
  capability fowner,
  capability fsetid,
  capability setgid,
  capability setuid,
  capability setpcap,
  capability net_bind_service,
  capability audit_write,
  capability dac_read_search,
  capability sys_ptrace,
  network,
  signal (send, receive) peer=confos-flatpak,
  signal (send, receive) peer=confos-session,
  signal (receive) peer=unconfined,
  ptrace (read, readby) peer=confos-flatpak,
  ptrace (read, readby) peer=confos-session,
  ptrace (read, readby) peer=unconfined,
  / r,
  /** r,
  /usr/** mrix,
  /app/** mrix,
  /lib/** mr,
  /lib64/** mr,
  /opt/** mr,
  /home/** rwkl,
  /tmp/** rwkl,
  /var/** rwkl,
  deny /var/lib/dpkg{,/**} wkl,
  deny /var/lib/apt{,/**} wkl,
  deny /var/spool/cron{,/**} wkl,
  deny /run/host/var/lib/dpkg{,/**} wkl,
  deny /run/host/var/lib/apt{,/**} wkl,
  deny /run/host/var/spool/cron{,/**} wkl,
  deny /proc/*/root/var/lib/dpkg{,/**} wkl,
  deny /proc/*/root/var/lib/apt{,/**} wkl,
  deny /proc/*/root/var/spool/cron{,/**} wkl,
  /run/** rwkl,
  /dev/null rw,
  /dev/zero rw,
  /dev/tty rw,
  /dev/ptmx rw,
  /dev/pts/** rw,
  /dev/random rw,
  /dev/urandom rw,
  /dev/shm/** rwkl,
# Draft fragment for BOTH confos-session and confos-flatpak, including sudo.
# Dedicated supervisor label and mount aliases need native tests before release.
deny network bluetooth,
deny unix (connect, send, receive) peer=(label=confos-radio),
deny capability net_admin,
deny capability net_raw,
deny capability sys_admin,
deny /dev/vhci rwklmx,
deny /dev/rfkill rwklmx,
deny /run/confos-radio{,/**} rwklmx,
deny /run/confos-radio-ready* rwklmx,
deny /var/lib/bluetooth{,/**} rwklmx,
deny /run/netns/confos-radio-ap rwklmx,
deny /var/run/confos-radio{,/**} rwklmx,
deny /var/run/netns/confos-radio-ap rwklmx,
deny /proc/*/root/run/confos-radio{,/**} rwklmx,
deny /proc/*/root/var/lib/bluetooth{,/**} rwklmx,
deny /proc/*/root/run/netns/confos-radio-ap rwklmx,

  # DECLARED_EXECUTABLES
}
