#!/usr/bin/env python3
"""run-extra: perform the cases of CASES-EXTRA.md (beyond the plan) into runs/<NAME>-extra/.

  run-extra --source BUILD_DIR --name NAME [--only ID,...] [--max-vms 1] [--vm-mem MIB] [--backend confos|stock]
  run-extra --list

The frozen runner `run` is loaded unchanged as a module; this program replaces only its list of cases (with
casedefs_extra.CASES) and adds two families of steps: `xrec` (a tool of installation or configuration records the
change in the declaration, S8.3-7) and `xradio` (connecting to a Wi-Fi network and pairing a Bluetooth device on
simulated radios). Machines, slots, inventories, derivations and comparisons are those of `run`. The rows are reported
apart from the rows of Table 9 and are not part of a complete run.
"""
import importlib.machinery
import json
from pathlib import Path
import re
import shutil
import sys
import time

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
R = importlib.machinery.SourceFileLoader('runmod', str(HERE / 'run')).load_module()
