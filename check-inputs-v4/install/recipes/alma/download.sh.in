#!/bin/bash
set -euo pipefail
export TZ=UTC
cd "@LAB_ROOT@/images"
mkdir -p alma-gpg
chmod 700 alma-gpg
curl -fLsS https://repo.almalinux.org/almalinux/10.3/isos/x86_64/CHECKSUM -o alma-CHECKSUM
curl -fLsS https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux-10 -o alma-key
curl --http1.1 -C - -fLsS --retry 3 https://repo.almalinux.org/almalinux/10.3/isos/x86_64/AlmaLinux-10.3-x86_64-dvd.iso -o AlmaLinux-10.3-x86_64-dvd.iso
GNUPGHOME="$PWD/alma-gpg" gpg --import alma-key > alma-verification.txt 2>&1
GNUPGHOME="$PWD/alma-gpg" gpg --verify alma-CHECKSUM >> alma-verification.txt 2>&1
printf '%s  %s\n' f74ae9c4a8e7e3e70147534856ea276f71649d16c70b7d3ec80d0905a7b93982 AlmaLinux-10.3-x86_64-dvd.iso | sha256sum -c - >> alma-verification.txt 2>&1
