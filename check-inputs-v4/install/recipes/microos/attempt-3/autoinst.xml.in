<?xml version="1.0"?>
<!DOCTYPE profile>
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <general><mode>
    <confirm config:type="boolean">false</confirm>
    <confirm_base_product_license config:type="boolean">true</confirm_base_product_license>
    <second_stage config:type="boolean">false</second_stage>
    <forceboot config:type="boolean">true</forceboot>
  </mode></general>
  <bootloader><global><append>combustion.firstboot</append></global></bootloader>
  <language><language>en_US</language></language>
  <keyboard><keymap>english-us</keymap></keyboard>
  <users config:type="list"><user><username>root</username><user_password>!</user_password><encrypted config:type="boolean">true</encrypted></user></users>
  <scripts><pre-scripts config:type="list"><script>
    <filename>instrument-start.sh</filename><interpreter>shell</interpreter>
    <source><![CDATA[
exec >/dev/null 2>&1
curl -fsS --max-time 5 http://10.0.2.2:18007/exit/autoyast-start/0 >/dev/null 2>&1
]]></source>
  </script></pre-scripts><chroot-scripts config:type="list"><script>
    <filename>instrument-firstboot.sh</filename><interpreter>shell</interpreter><chrooted config:type="boolean">true</chrooted>
    <source><![CDATA[
exec >/dev/null 2>&1
set -eu
curl -fsS --max-time 5 http://10.0.2.2:18007/exit/chroot-start/0 >/dev/null 2>&1 || :
rm -f /etc/machine-id
set +e
dracut --force --no-hostonly --add 'combustion firstboot'
rc=$?
curl -fsS --max-time 5 "http://10.0.2.2:18007/exit/dracut/$rc" >/dev/null 2>&1 || :
exit "$rc"
]]></source>
  </script></chroot-scripts></scripts>
</profile>
