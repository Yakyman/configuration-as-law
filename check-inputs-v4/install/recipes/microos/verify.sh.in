#!/bin/bash
set -euo pipefail
root="@LAB_ROOT@"
cd "$root/images"
image=openSUSE-MicroOS-DVD-x86_64-Snapshot20261121-Media.iso
sha256sum -c "$image.sha256"
keydir=$(mktemp -d "$root/C1/microos/verify.XXXXXX")
trap 'rm -rf "$keydir"' EXIT
chmod 700 "$keydir"
curl -fsSL https://download.opensuse.org/tumbleweed/repo/oss/repodata/repomd.xml.key -o "$keydir/key.asc"
gpg --homedir "$keydir" --batch --import "$keydir/key.asc" >/dev/null 2>&1
gpg --homedir "$keydir" --batch --status-fd 1 --verify "$image.sha256.asc" "$image.sha256" 2>/dev/null | tee "$keydir/signature-status"
grep -q '^\[GNUPG:\] VALIDSIG AD485664E901B867051AB15F35A2F86E29B700A4 ' "$keydir/signature-status"
