#!/usr/bin/env python3
import pathlib,subprocess as sp,fcntl,time,json,shutil
r=pathlib.Path(__file__).resolve().parents[2];d=r/'C1/vms/kit-timeout'
d.mkdir();records=[]
try:
 t=time.monotonic();p=sp.Popen([str(r/'lab.sh'),'run','kit-timeout','--timeout','2'],stdin=sp.PIPE,stdout=sp.PIPE,stderr=sp.PIPE)
 p.wait(timeout=5);p.stdin.close();records.append(dict(test='stdin-timeout',status=p.returncode,seconds=round(time.monotonic()-t,2),passed=p.returncode==124))
 with (d/'run.lock').open('a') as f:
  fcntl.flock(f,fcntl.LOCK_EX)
  t=time.monotonic();p=sp.run([str(r/'lab.sh'),'run','kit-timeout','--timeout','2'],input=b'exit 0\n',stdout=sp.PIPE,stderr=sp.PIPE,timeout=5)
  records.append(dict(test='lock-timeout',status=p.returncode,seconds=round(time.monotonic()-t,2),passed=p.returncode==124))
finally:shutil.rmtree(d)
print(json.dumps(records,indent=2))
