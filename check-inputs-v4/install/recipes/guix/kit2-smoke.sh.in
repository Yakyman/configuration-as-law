#!/bin/bash
set -uo pipefail
cd "$(dirname "$0")/../.."
status=install/guix/kit2-status.txt
printf 'started=%s\n' "$(date -u +%FT%TZ)" > "$status"
cleanup() {
 ./lab.sh stop guix-kit2 >/dev/null 2>&1
 stop_rc=$?
 printf 'native_stop_status=%s\n' "$stop_rc" >> "$status"
 if test "$stop_rc" != 0; then
  ./lab.sh kill guix-kit2 >/dev/null 2>&1
  printf 'forced_stop_status=%s\n' "$?" >> "$status"
 fi
 ./lab.sh destroy guix-kit2 >/dev/null 2>&1
 printf 'destroy_status=%s\n' "$?" >> "$status"
 printf 'finished=%s\n' "$(date -u +%FT%TZ)" >> "$status"
}
trap cleanup EXIT
timeout --kill-after=10 300 ./lab.sh new guix-kit2 guix >/dev/null 2>&1
rc=$?
printf 'fresh_boot_login_status=%s\n' "$rc" >> "$status"
if test "$rc" != 0; then exit "$rc"; fi
printf 'exec >/dev/null 2>&1\nexit 37\n' | ./lab.sh run guix-kit2 --timeout 90 >/dev/null 2>&1
printf 'user_exit37_status=%s\n' "$?" >> "$status"
printf 'exec >/dev/null 2>&1\nexit 0\n' | ./lab.sh run guix-kit2 --root --timeout 90 >/dev/null 2>&1
printf 'root_exit0_status=%s\n' "$?" >> "$status"
