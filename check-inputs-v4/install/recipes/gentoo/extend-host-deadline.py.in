#!/usr/bin/env python3
"""Extend a host timeout while retaining the installer SSH exit status.
Only host process metadata of the two explicitly supplied instrument PIDs is read.
The timeout parent is stopped; its still-running SSH child retains its exit status
as a zombie until this watchdog collects the numeric wait status and kills the
stopped monitor. No check-system output or process information is accessed.
"""
import datetime, os, pathlib, signal, subprocess, sys, time
monitor_pid, ssh_pid = map(int, sys.argv[1:3])
deadline = float(sys.argv[3])
record = pathlib.Path(sys.argv[4])
result = 124
finished = False
try:
    while time.time() < deadline:
        data = pathlib.Path(f'/proc/{ssh_pid}/stat').read_text()
        fields = data[data.rfind(')')+2:].split()
        if fields[0] == 'Z':
            result = os.waitstatus_to_exitcode(int(fields[49]))
            if result < 0:
                result = 128 - result
            finished = True
            break
        time.sleep(2)
    if not finished:
        try:
            os.kill(ssh_pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        # Definitively bound the guest installer at the actual hour limit.
        subprocess.run(['systemctl', '--user', 'stop', 'cal1123-gentoo-bootstrap'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=30)
finally:
    try:
        os.kill(monitor_pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    record.write_text(str(result)+'\n')
