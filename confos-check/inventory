    # ref, commit and installation from the second
    run flatpakplain:root flatpak list
    for id in $(flatpak list 2>/dev/null | tr '\t' '\n' | grep -E '^[A-Za-z][A-Za-z0-9_-]*([.][A-Za-z][A-Za-z0-9_-]*){2,}$' | sort -u); do
      run "flatpakinfo:$id" flatpak info "$id"
    done
