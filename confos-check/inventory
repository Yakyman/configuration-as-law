'''


def log(msg):
    print('inventory: ' + msg, file=sys.stderr, flush=True)


NON_UTF8 = [0]


def jdump(path, objs):
    """JSON Lines, UTF-8. A byte of a name that is not UTF-8 (read with surrogateescape) is written as the four
    characters \\xHH, as `ls -b` shows it; meta.non_utf8_strings counts such strings."""
    objs = sorted(objs, key=lambda o: (o['kind'], o['id']))
    with open(path, 'w', encoding='utf-8') as f:
        for o in objs:
            s = json.dumps(o, sort_keys=True, ensure_ascii=False)
            if re.search('[\udc80-\udcff]', s):
                NON_UTF8[0] += 1
                s = re.sub('[\udc80-\udcff]', lambda m: '\\\\x%02x' % (ord(m.group()) - 0xdc00), s)
            f.write(s + '\n')


def sha_bytes(b):
    return hashlib.sha256(b).hexdigest()


def exec_of(kind, mode, name, head):
    """Return (exec, reason) for an object; head is the first bytes of a regular file."""
    if kind not in ('file', 'vfile'):
        return False, None
    if head[:4] == b'\x7fELF':
        return True, 'elf'
    if head[:2] == b'#!':
        return True, 'shebang'
    if mode & 0o111:
        return True, 'mode'
    base = name.rsplit('/', 1)[-1]
    if base in EXEC_NAMES or base.endswith(EXEC_SUFFIXES):
        return True, 'suffix'
    return False, None


def image_type(head):
    if head[:4] == b'hsqs':
        return 'squashfs'
    if len(head) >= 1082 and head[1080:1082] == b'\x53\xef':
        return 'ext'
    if len(head) >= 32774 and head[32769:32774] == b'CD001':
        return 'iso9660'
    if len(head) >= 512 and head[510:512] == b'\x55\xaa' and (head[54:57] == b'FAT' or head[82:87] == b'FAT32'):
        return 'fat'
    return None


# ----------------------------------------------------------------------------------------------------------------
# Force level

class Sections:
    def __init__(self, out, err, token):
        self.sec = {}
        self.rc = {}
        self.err = {}
        pat = re.compile(rb'\n@@' + token.encode() + rb' (BEGIN|END) (\S+?)(?: (-?\d+))?@@\n')
        for stream, store in ((out, 'out'), (err, 'err')):
            pos = 0
            cur = None
            for m in pat.finditer(stream):
                if m.group(1) == b'BEGIN':
                    cur = m.group(2).decode('utf-8', 'replace')
                    pos = m.end()
                else:
                    name = m.group(2).decode('utf-8', 'replace')
                    data = stream[pos:m.start()]
                    if store == 'out':
                        self.sec[name] = data
                        self.rc[name] = int(m.group(3)) if m.group(3) is not None else None
                    else:
                        self.err[name] = data.decode('utf-8', 'replace').strip()
                    cur = None

    def text(self, name):
        return self.sec.get(name, b'').decode('utf-8', 'surrogateescape')

    def names(self, prefix):
        return sorted(n[len(prefix):] for n in self.sec if n.startswith(prefix))


def parse_show(text):
    blocks, cur = [], {}
    for line in text.split('\n'):
        if not line.strip():
            if cur:
                blocks.append(cur)
                cur = {}
            continue
        k, _, v = line.partition('=')
        cur[k] = v
    if cur:
        blocks.append(cur)
    return blocks


def take_force(args, objs, errors):
    """Run the collector over SSH; returns (Sections, meta-dict) and appends objects."""
    marker = secrets.token_hex(8)
    fw_fallback = args.firewall_fallback  # `args` is reused below for a process's command line
    ssh = ['ssh', '-i', args.ssh_key, '-p', str(args.ssh_port), '-o', 'BatchMode=yes',
           '-o', 'StrictHostKeyChecking=no', '-o', 'UserKnownHostsFile=/dev/null', '-o', 'LogLevel=ERROR',
           '-o', 'ConnectTimeout=20', f'{args.user}@{args.ssh_host}', f'{args.root_cmd} bash -s -- {marker}' +
           (' ' + base64.b64encode(args.firewall_fallback.encode()).decode() if args.firewall_fallback else '')]
    t0 = time.time()
    p = subprocess.run(ssh, input=COLLECTOR.encode(), capture_output=True, timeout=args.timeout)
    log(f'force level collected in {time.time() - t0:.1f}s, ssh exit {p.returncode}, {len(p.stdout)} bytes')
    if p.returncode != 0 and b'BEGIN meta_boot' not in p.stdout:
        raise RuntimeError('ssh collector failed: ' + p.stderr.decode('utf-8', 'replace')[-2000:])
    if getattr(args, 'raw', None):
        with open(args.raw, 'wb') as f:
            f.write(p.stdout + b'\n@@STDERR@@\n' + p.stderr)
    S = Sections(p.stdout, p.stderr, marker)
    if 'sync' not in S.sec:
        errors.append({'kind': 'error', 'id': 'force/collector', 'detail': 'collector did not finish: ' +
                       p.stderr.decode('utf-8', 'replace')[-2000:]})

    def err(name, detail=None):
        errors.append({'kind': 'error', 'id': 'force/' + name, 'rc': S.rc.get(name),
                       'detail': detail or S.err.get(name, '')[:4000]})

    def absent(name):
        return S.rc.get(name) == 127

    meta = {'boot_id': S.text('meta_boot').strip(), 'kernel_release': S.text('meta_kernel').strip(),
            'time_utc': S.text('meta_time').strip(), 'inventory_session': S.text('meta_session').strip(),
            'hostname': S.text('meta_hostname').strip(), 'pid1_exe': S.text('meta_pid1').strip(),
            'cmdline': S.text('meta_cmdline').strip()}

    # packages
    if absent('dpkg'):
        objs.append({'kind': 'package', 'id': 'dpkg', 'value': {'tool': 'absent'}})
    elif S.rc.get('dpkg') != 0:
        err('dpkg')
    for line in S.text('dpkg').splitlines():
        f = line.split('\t')
        if len(f) == 4:
            objs.append({'kind': 'package', 'id': f'{f[0]}:{f[1]}', 'value': {'version': f[2], 'status': f[3].strip()}})

    # processes (needed for units and ports)
    procs = {}
    uname = {}
    for line in S.text('passwd').splitlines():
        f = line.split(':')
        if len(f) > 2:
            uname.setdefault(f[2], f[0])
    for line in S.text('procexe').splitlines():
        f = line.split('\t')
        if len(f) >= 7:
            args = f[6].strip() or f'[{f[5]}]'
            procs[f[0]] = {'exe': f[1], 'cgroup': f[2], 'ppid': f[3], 'user': uname.get(f[4], f[4]), 'args': args}
    psrows = {}
    for line in S.text('ps').splitlines():
        m = re.match(r'\s*(\d+)\s+(\d+)\s+(\S+)\s*(.*)$', line)
        if m:
            psrows[m.group(1)] = (m.group(2), m.group(3), m.group(4))
    if S.rc.get("ps") != 0 or not psrows:
        # no ps on the machine: the same fields read from /proc by the collector
        psrows = {pid: (i['ppid'], i['user'], i['args']) for pid, i in procs.items()}
        meta['process_source'] = '/proc (ps absent or failed: ' + S.err.get('ps', '')[:200] + ')'
    pobj = {}
    for pid, (ppid, user, a) in psrows.items():
        if marker in a:
            continue  # the collector of this inventory itself (its command line carries the per-run marker)
        info = procs.get(pid, {'exe': '', 'cgroup': ''})
        exe = info['exe']
        if not exe:
            if pid == '2' or ppid == '2':
                exe = '[kthread]'
            else:
                exe = '[exe-unreadable]'
                if pid not in procs:
                    continue  # exited between ps and readlink
        if exe.endswith(' (deleted)'):
            exe = exe  # kept as is: the executable is no longer on the filesystem
        o = pobj.setdefault(exe, {'kind': 'process', 'id': exe, 'value': {'users': set(), 'count': 0, 'args': set()}})
        o['value']['users'].add(user)
        o['value']['count'] += 1
        o['value']['args'].add(a)
    for o in pobj.values():
        o['value']['users'] = sorted(o['value']['users'])
        o['value']['args'] = sorted(o['value']['args'])
        objs.append(o)
    pid_exe = {pid: (procs.get(pid, {}).get('exe') or '') for pid in set(psrows) | set(procs)}

    def pid_exe_of(p):
        return pid_exe.get(p) or f'[pid {p} gone]'

    def members(cg):
        if not cg:
            return []
        out = set()
        for pid, info in procs.items():
            c = info.get('cgroup', '')
            if c == cg or c.startswith(cg.rstrip('/') + '/'):
                out.add(info.get('exe') or ('[kthread]' if psrows.get(pid, ('',))[0] == '2' else '[exe-unreadable]'))
        return sorted(out)

    # units
    def units(prefix, files_s, list_s, show_s):
        state = {}
        for line in S.text(files_s).splitlines():
            f = line.split()
            if len(f) >= 2:
                state[f[0]] = f[1]
        listed = {}
        for line in S.text(list_s).splitlines():
            f = line.split(None, 4)
            if len(f) >= 4:
                listed[f[0]] = (f[1], f[2], f[3])
        if S.rc.get(files_s) not in (0, None):
            err(files_s)
        shown = {}
        for b in parse_show(S.text(show_s)):
            if 'Id' in b:
                shown[b['Id']] = b
        if S.rc.get(show_s) not in (0, None):
            err(show_s)
        for name in sorted(set(state) | set(listed)):
            b = shown.get(name, {})
            transient = b.get('Transient') == 'yes'
            v = {'enabled': state.get(name, b.get('UnitFileState', '')),
                 'active': b.get('ActiveState', listed.get(name, ('', '', ''))[1]),
                 'sub': b.get('SubState', listed.get(name, ('', '', ''))[2]),
                 'load': b.get('LoadState', listed.get(name, ('', '', ''))[0]),
                 'fragment': b.get('FragmentPath', ''), 'source': b.get('SourcePath', ''),
                 'dropins': b.get('DropInPaths', ''), 'transient': transient}
            if transient:
                v['members'] = members(b.get('ControlGroup', ''))
            objs.append({'kind': 'unit', 'id': prefix + name, 'value': v})

    units('system/', 'units_files', 'units_list', 'units_show')
    managers = [u for u in S.text('usermanagers').split() if u]
    for u in managers:
        units(f'user/{u}/', f'uunits_files:{u}', f'uunits_list:{u}', f'uunits_show:{u}')
    meta['user_managers'] = managers
    meta['linger'] = S.text('linger').split()

    # accounts
    for name in ('passwd', 'group'):
        if S.rc.get(name) != 0:
            err(name)
    groups = []
    for line in S.text('group').splitlines():
        f = line.split(':')
        if len(f) >= 4 and f[0]:
            groups.append(f)
            members = sorted(x for x in f[3].split(',') if x)
            objs.append({'kind': 'group', 'id': f[0], 'value': {'fields': f, 'name': f[0], 'password': f[1],
                                                               'gid': int(f[2]) if f[2].isdigit() else f[2],
                                                               'members': members}})
    for line in S.text('passwd').splitlines():
        f = line.split(':')
        if len(f) >= 7 and f[0]:
            supp = sorted(g[0] for g in groups if f[0] in g[3].split(','))
            objs.append({'kind': 'account', 'id': f[0], 'value': {
                'fields': f, 'name': f[0], 'password': f[1], 'uid': int(f[2]) if f[2].isdigit() else f[2],
                'gid': int(f[3]) if f[3].isdigit() else f[3], 'gecos': f[4], 'home': f[5], 'shell': f[6],
                'groups': supp}})
    count = {}
    for n in S.names('akeys:'):
        for line in S.text(f'akeys:{n}').splitlines():
            path, _, key = line.partition('\t')
            parts = key.split()
            # options may precede the type; the type is the first field that looks like one
            ti = next((i for i, p in enumerate(parts) if re.match(r'^(ssh-|ecdsa-|sk-)', p)), None)
            if ti is None or ti + 1 >= len(parts):
                continue
            kid = f'{n}/{parts[ti]}'
            c = count.get(kid, 0) + 1
            count[kid] = c
            objs.append({'kind': 'authorized-key', 'id': kid + (f'#{c}' if c > 1 else ''),
                         'value': {'account': n, 'type': parts[ti], 'key': parts[ti + 1],
                                   'key_sha256': sha_bytes(parts[ti + 1].encode()), 'file': path,
                                   'options': ' '.join(parts[:ti])}})
    # settings asked with the standard tools
    objs.append({'kind': 'setting', 'id': 'hostname', 'value': {'name': 'hostname', 'value': meta['hostname']}})
    tz = S.text('timezone').strip()
    if S.rc.get('timezone') == 0 and tz:
        objs.append({'kind': 'setting', 'id': 'timezone', 'value': {'name': 'timezone', 'value': tz}})
    else:
        err('timezone')
    for line in S.text('shadow').splitlines():
        f = line.split('\t')
        if len(f) == 2:
            objs.append({'kind': 'shadow', 'id': f[0], 'value': {'hash_sha256': f[1]}})

    # access
    sud = S.names('sudol:')
    if 'sudol' in S.sec:
        objs.append({'kind': 'access', 'id': 'sudo', 'value': {'tool': 'absent' if absent('sudol') else 'error'}})
    for n in sud:
        objs.append({'kind': 'access', 'id': f'sudo-l/{n}',
                     'value': {'rc': S.rc.get(f'sudol:{n}'), 'text': S.text(f'sudol:{n}')}})

    def hashed(section, kind, prefix):
        data = S.sec.get(section, b'')
        for rec in data.split(b'\0'):
            rec = rec.lstrip(b'\n')
            if not rec:
                continue
            h, _, path = rec.partition(b'  ')
            p = path.decode('utf-8', 'surrogateescape')
            objs.append({'kind': kind, 'id': prefix + p, 'value': {'sha256': h.decode()}})
        if S.rc.get(section) not in (0, None):
            err(section)

    hashed('accessfiles', 'access', 'file:')
    hashed('authkeys', 'access', 'file:')

    # modules
    modfile = {}
    for line in S.text('modfiles').splitlines():
        f = line.split('\t')
        if len(f) == 2:
            modfile[f[0]] = f[1]
    for line in S.text('modules').splitlines():
        f = line.split()
        if f:
            objs.append({'kind': 'module', 'id': f[0], 'value': {'size': f[1], 'file': modfile.get(f[0], '')}})

    # ports
    seen = {}
    if absent('ports'):
        objs.append({'kind': 'port', 'id': 'ss', 'value': {'tool': 'absent'}})
        meta['port_source'] = '/proc/net (ss absent)'
        ino_pids = {}
        for line in S.text('sockinodes').splitlines():
            f = line.split('\t')
            mm = re.match(r'socket:\[(\d+)\]', f[1]) if len(f) == 2 else None
            if mm:
                ino_pids.setdefault(mm.group(1), set()).add(f[0])
        for x in ('tcp', 'tcp6', 'udp', 'udp6'):
            for line in S.text(f'procnet:{x}').splitlines()[1:]:
                f = line.split()
                if len(f) < 10 or f[3] != ('0A' if x.startswith('tcp') else '07'):
                    continue
                ah, ph = f[1].split(':')
                raw = bytes.fromhex(ah)
                if len(raw) == 4:
                    addr = str(ipaddress.IPv4Address(raw[::-1]))
                else:
                    addr = '[' + str(ipaddress.IPv6Address(b''.join(raw[i:i + 4][::-1] for i in range(0, 16, 4)))) + ']'
                pid_id = f'{x[:3]}/{addr}:{int(ph, 16)}'
                exes = sorted({pid_exe_of(p) for p in ino_pids.get(f[9], ())}) or ['[no process]']
                o = seen.setdefault(pid_id, {'kind': 'port', 'id': pid_id, 'value': {'exe': set()}})
                o['value']['exe'].update(exes)
    elif S.rc.get('ports') != 0:
        err('ports')
    for line in S.text('ports').splitlines():
        f = line.split()
        if len(f) < 5:
            continue
        proto, local = f[0], f[4]
        pids = re.findall(r'pid=(\d+)', line)
        exes = sorted({pid_exe.get(p) or f'[pid {p} gone]' for p in pids}) or ['[no process]']
        pid_id = f'{proto}/{local}'
        o = seen.setdefault(pid_id, {'kind': 'port', 'id': pid_id, 'value': {'exe': set()}})
        o['value']['exe'].update(exes)
    for o in seen.values():
        o['value']['exe'] = sorted(o['value']['exe'])
        objs.append(o)

    # firewall
    if absent('nft'):
        objs.append({'kind': 'firewall', 'id': 'nft', 'value': {'tool': 'absent'}})
    elif S.rc.get('nft') != 0 and S.rc.get('nftalt') == 0:
        # nft refused even to root; the native nft text printed by the fallback command (FORMATS.md, inventory)
        meta['firewall_source'] = {'nft_refused': S.err.get('nft', '')[:400], 'read_with': fw_fallback}
        count = {}
        cur = [None, None, None]
        for tl in S.text('nftalt').splitlines():
            t = tl.strip()
            mt = re.match(r'table (\S+) (\S+) \{', t)
            mc = re.match(r'chain (\S+) \{', t)
            if mt:
                cur = [mt.group(1), mt.group(2), None]
                fid, body = f'nft/table {cur[0]} {cur[1]}', {'family': cur[0], 'name': cur[1]}
            elif mc and cur[1]:
                cur[2] = mc.group(1)
                fid, body = f'nft/chain {cur[0]} {cur[1]}/{cur[2]}', {'family': cur[0], 'table': cur[1],
                                                                       'name': cur[2], 'text': []}
            elif t == '}' or not t:
                if t == '}' and cur[2]:
                    cur[2] = None
                continue
            elif cur[2] and t.startswith(('type ', 'policy ')):
                for o in reversed(objs):
                    if o['id'] == f'nft/chain {cur[0]} {cur[1]}/{cur[2]}':
                        o['value']['text'].append(t)
                        break
                continue
            elif cur[2]:
                fid = f'nft/rule {cur[0]} {cur[1]}/{cur[2]}/text:{t}'
                body = {'family': cur[0], 'table': cur[1], 'chain': cur[2], 'text': t}
            else:
                fid, body = f'nft/other {cur[0]} {cur[1]}/{t}', {'text': t}
            body['via'] = fw_fallback
            n = count.get(fid, 0) + 1
            count[fid] = n
            objs.append({'kind': 'firewall', 'id': fid + (f'#{n}' if n > 1 else ''), 'value': body})
    elif S.rc.get('nft') != 0:
        err('nft')
    else:
        try:
            data = json.loads(S.text('nft') or '{"nftables":[]}')
        except ValueError as e:
            data = {'nftables': []}
            err('nft', 'json: ' + str(e))
        count = {}
        # the rule text as nft itself prints it (`nft -a list ruleset`), keyed by family, table, chain, handle
        rtext, cur = {}, [None, None, None]
        for tl in (S.text('nfttext') if S.rc.get('nfttext') == 0 else '').splitlines():
            t = tl.strip()
            mt = re.match(r'table (\S+) (\S+) \{', t)
            mc = re.match(r'chain (\S+) \{', t)
            mr = re.match(r'(.*\S)\s+# handle (\d+)$', t)
            if mt:
                cur = [mt.group(1), mt.group(2), None]
            elif mc:
                cur[2] = mc.group(1)
            elif mr and cur[2] and not t.startswith(('type ', 'policy ')):
                rtext[(cur[0], cur[1], cur[2], int(mr.group(2)))] = mr.group(1)
        for item in data.get('nftables', []):
            for typ, body in item.items():
                if typ == 'metainfo':
                    continue
                hnd = body.get('handle')
                body = {k: v for k, v in body.items() if k != 'handle'}
                if typ == 'rule':
                    body['text'] = rtext.get((body.get('family'), body.get('table'), body.get('chain'), hnd))
                fam, tab = body.get('family', ''), body.get('table', body.get('name', ''))
                if typ == 'table':
                    fid = f'nft/table {fam} {body.get("name")}'
                elif typ == 'chain':
                    fid = f'nft/chain {fam} {tab}/{body.get("name")}'
                elif typ == 'rule':
                    fid = f'nft/rule {fam} {tab}/{body.get("chain")}/' + json.dumps(body.get('expr'), sort_keys=True)
                else:
                    fid = f'nft/{typ} {fam} {tab}/{body.get("name", json.dumps(body, sort_keys=True))}'
                n = count.get(fid, 0) + 1
                count[fid] = n
                if n > 1:
                    fid += f'#{n}'
                objs.append({'kind': 'firewall', 'id': fid, 'value': body})
    for name in ('iptables', 'ip6tables'):
        if absent(name):
            objs.append({'kind': 'firewall', 'id': name, 'value': {'tool': 'absent'}})
            continue
        if S.rc.get(name) != 0:
            err(name)
        table = ''
        count = {}
        for line in S.text(name).splitlines():
            if line.startswith('#') or not line.strip() or line == 'COMMIT':
                continue
            if line.startswith('*'):
                table = line[1:]
                continue
            if line.startswith(':'):
                line = re.sub(r'\s*\[\d+:\d+\]$', '', line)
            fid = f'{name}/{table}/{line}'
            n = count.get(fid, 0) + 1
            count[fid] = n
            objs.append({'kind': 'firewall', 'id': fid + (f'#{n}' if n > 1 else ''), 'value': {}})

    # network
    for name, tool in (('nmcli', 'nmcli'), ('networkctl', 'networkctl')):
        if absent(name):
            objs.append({'kind': 'network', 'id': tool, 'value': {'tool': 'absent'}})
            continue
        for line in S.text(name).splitlines():
            if not line.strip():
                continue
            if name == 'nmcli':
                f = line.split(':')
                objs.append({'kind': 'network', 'id': f'nmcli/{f[0]}', 'value': {'fields': f}})
            else:
                f = line.split()
                if len(f) >= 2:
                    objs.append({'kind': 'network', 'id': f'link/{f[1]}', 'value': {'fields': f[2:]}})
    hashed('netfiles', 'network', 'file:')
    try:
        for a in json.loads(S.text('ipaddr') or '[]'):
            for ai in a.get('addr_info', []):
                v = {k: x for k, x in ai.items() if k not in ('valid_life_time', 'preferred_life_time')}
                objs.append({'kind': 'network', 'id': f'addr/{a.get("ifname")}/{ai.get("local")}/{ai.get("prefixlen")}',
                             'value': v})
        for name in ('iproute4', 'iproute6'):
            count = {}
            for r in json.loads(S.text(name) or '[]'):
                r = {k: x for k, x in r.items() if k not in ('expires',)}
                fid = 'route/' + ' '.join(f'{k}={r[k]}' for k in ('table', 'type', 'dst', 'gateway', 'dev') if k in r)
                n = count.get(fid, 0) + 1
                count[fid] = n
                objs.append({'kind': 'network', 'id': fid + (f'#{n}' if n > 1 else ''), 'value': r})
    except ValueError as e:
        err('ip', str(e))

    # mounts
    mounts = []
    if absent('findmnt'):
        # no findmnt on the machine: the kernel's own table (/proc/self/mountinfo); no UUIDs
        meta['mount_source'] = '/proc/self/mountinfo (findmnt absent)'

        def unesc(s):
            return re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), s)
        for line in S.text('mountinfo').splitlines():
            f = line.split()
            if '-' not in f:
                continue
            k = f.index('-', 6)
            mounts.append({'target': unesc(f[4]), 'source': unesc(f[k + 2]) if k + 2 < len(f) else '',
                           'fstype': f[k + 1], 'options': f[5] + (',' + f[k + 3] if k + 3 < len(f) else ''),
                           'fsroot': unesc(f[3]), 'uuid': None, 'label': None, 'partuuid': None,
                           'majmin': f[2]})
    else:
        try:
            mounts = json.loads(S.text('findmnt') or '{}').get('filesystems', [])
        except ValueError as e:
            err('findmnt', str(e))
    loops = {}
    try:
        for l in json.loads(S.text('losetup') or '{}').get('loopdevices', []):
            loops[l.get('name')] = l
    except ValueError:
        pass
    loopsha = {}
    for line in S.text('loopsha').splitlines():
        f = line.split('\t')
        if len(f) == 2:
            loopsha[f[0]] = f[1]
    munits = {}
    for b in parse_show(S.text('mountunits')):
        if b.get('Where'):
            munits[b['Where']] = b
    count = {}
    for m in mounts:
        tgt = m.get('target')
        src = m.get('source') or ''
        dev = src.split('[')[0]
        u = munits.get(tgt, {})
        creator = u.get('SourcePath') or u.get('FragmentPath') or ''
        v = {'source': src, 'fstype': m.get('fstype'), 'options': m.get('options'), 'fsroot': m.get('fsroot'),
             'uuid': m.get('uuid'), 'label': m.get('label'), 'creator': creator}
        if dev in loops:
            v['loop_back_file'] = loops[dev].get('back-file')
            v['loop_sha256'] = loopsha.get(dev)
            v['loop_offset'] = loops[dev].get('offset')
        n = count.get(tgt, 0) + 1
        count[tgt] = n
        objs.append({'kind': 'mount', 'id': tgt + (f'#{n}' if n > 1 else ''), 'value': v})

    # cron
    if 'crontab' in S.sec:
        objs.append({'kind': 'crontab', 'id': 'crontab', 'value': {'tool': 'absent' if absent('crontab') else 'error'}})
    for n in S.names('crontab:'):
        t = S.text(f'crontab:{n}')
        if S.rc.get(f'crontab:{n}') == 0 or t.strip():
            objs.append({'kind': 'crontab', 'id': f'user/{n}', 'value': {'sha256': sha_bytes(S.sec[f'crontab:{n}']),
                                                                        'text': t}})
    hashed('cronfiles', 'crontab', 'file:')

    # flatpak, containers, language packages
    if 'flatpak' in S.sec:
        objs.append({'kind': 'flatpak', 'id': 'flatpak', 'value': {'tool': 'absent' if absent('flatpak') else 'error'}})
    for n in S.names('flatpak:'):
        if S.rc.get(f'flatpak:{n}') != 0 and not (n == 'root' and S.rc.get('flatpakplain:root') == 0):
            err(f'flatpak:{n}')
        for line in S.text(f'flatpak:{n}').splitlines():
            f = line.split('\t')
            if f and f[0]:
                v = {'fields': f}
                for i, k in ((4, 'commit'), (5, 'branch'), (6, 'arch')):
                    if len(f) > i and f[i]:
                        v[k] = f[i]
                objs.append({'kind': 'flatpak', 'id': f'{n}/{f[0]}/{f[3] if len(f) > 3 else ""}', 'value': v})
    for i in S.names('flatpakinfo:'):
        if S.rc.get(f'flatpakinfo:{i}') != 0:
            err(f'flatpakinfo:{i}')
            continue
        kv = {k.strip().lower(): v.strip() for k, _, v in
              (l.partition(':') for l in S.text(f'flatpakinfo:{i}').splitlines() if ':' in l)}
        ref = kv.get('ref', '')
        v = {'ref': ref, 'commit': kv.get('commit'), 'branch': kv.get('branch'), 'arch': kv.get('arch'),
             'installation': kv.get('installation'), 'tool': 'flatpak info'}
        objs.append({'kind': 'flatpak', 'id': f'root/{i}/{kv.get("installation", "")}', 'value': v})
    if 'flatpakplain:root' in S.sec and S.rc.get('flatpakplain:root') != 0:
        err('flatpakplain:root')
    if 'podman' in S.sec:
        objs.append({'kind': 'container', 'id': 'podman', 'value': {'tool': 'absent' if absent('podman') else 'error'}})
    for n in S.names('podpsplain:'):
        if S.rc.get(f'podpsplain:{n}') != 0:
            err(f'podpsplain:{n}')
            continue
        for l in S.text(f'podpsplain:{n}').splitlines()[1:]:
            f = l.split()
            if len(f) >= 2:
                objs.append({'kind': 'container', 'id': f'{n}/container/{f[0]}',
                             'value': {'image': f[1], 'line': l.strip(), 'tool': 'podman ps -a'}})
    for n in S.names('podps:'):
        if S.rc.get(f'podps:{n}') != 0 and S.rc.get(f'podpsplain:{n}') != 0:
            err(f'podps:{n}')
        try:
            for c in json.loads(S.text(f'podps:{n}') or '[]'):
                objs.append({'kind': 'container', 'id': f'{n}/container/{c.get("Id")}',
                             'value': {'image': c.get('Image'), 'names': c.get('Names'), 'command': c.get('Command'),
                                       'state': c.get('State')}})
        except ValueError as e:
            err(f'podps:{n}', str(e))
    for nr in S.names('podinspect:'):
        n = nr.split(':', 1)[0]
        if S.rc.get(f'podinspect:{nr}') != 0:
            err(f'podinspect:{nr}')
            continue
        try:
            for c in json.loads(S.text(f'podinspect:{nr}') or '[]'):
                objs.append({'kind': 'container', 'id': f'{n}/image/{c.get("Id")}',
                             'value': {'names': c.get('RepoTags'), 'digest': c.get('Digest'),
                                       'tool': 'podman image inspect'}})
        except ValueError as e:
            err(f'podinspect:{nr}', str(e))
    for n in S.names('podimg:'):
        if S.rc.get(f'podimg:{n}') != 0 and not any(x.startswith(n + ':') for x in S.names('podinspect:')) \
                and S.rc.get(f'podimgplain:{n}') != 0:
            err(f'podimg:{n}')
        try:
            for c in json.loads(S.text(f'podimg:{n}') or '[]'):
                objs.append({'kind': 'container', 'id': f'{n}/image/{c.get("Id")}',
                             'value': {'names': c.get('Names'), 'digest': c.get('Digest')}})
        except ValueError as e:
            err(f'podimg:{n}', str(e))
    for py in S.names('pipq:'):
        if S.rc.get(f'pipq:{py}') != 0:
            err(f'pipq:{py}')
            continue
        try:
            for d in json.loads(S.text(f'pipq:{py}') or '[]'):
                objs.append({'kind': 'language-package', 'id': f'pip:{py}/{d.get("name")}',
                             'value': {'version': d.get('version'), 'tool': 'pip list (restricted entry)'}})
        except ValueError as e:
            err(f'pipq:{py}', str(e))
    for py in S.names('pip:'):
        if S.rc.get(f'pip:{py}') != 0 and S.rc.get(f'pipq:{py}') == 0:
            continue
        try:
            for d in json.loads(S.text(f'pip:{py}') or '[]'):
                objs.append({'kind': 'language-package', 'id': f'pip:{py}/{d.get("name")}',
                             'value': {'version': d.get('version'), 'tool': 'pip list'}})
        except ValueError as e:
            err(f'pip:{py}', str(e))
    for py in S.names('pymeta:'):
        if S.rc.get(f'pymeta:{py}') != 0:
            err(f'pymeta:{py}')
            continue
        objs.append({'kind': 'language-package', 'id': f'pip:{py}', 'value': {'pip': 'absent'}})
        try:
            for name, ver, path in json.loads(S.text(f'pymeta:{py}') or '[]'):
                objs.append({'kind': 'language-package', 'id': f'pip:{py}/{name}',
                             'value': {'version': ver, 'tool': 'importlib.metadata', 'path': path}})
        except ValueError as e:
            err(f'pymeta:{py}', str(e))
    for pf in S.names('npm:'):
        if absent(f'npm:{pf}'):
            objs.append({'kind': 'language-package', 'id': f'npm:{pf}', 'value': {'npm': 'absent'}})
            continue
        try:
            deps = json.loads(S.text(f'npm:{pf}') or '{}').get('dependencies', {})
            for name, d in deps.items():
                objs.append({'kind': 'language-package', 'id': f'npm:{pf}/{name}', 'value': {'version': d.get('version')}})
        except ValueError as e:
            err(f'npm:{pf}', str(e))
    for sec, pfx in (('npmprojtxt:', ''), ('npmtxt:', '')):
        for pj in S.names(sec):
            if S.rc.get(sec + pj) != 0:
                err(sec + pj)
                continue
            for l in S.text(sec + pj).splitlines():
                m = re.match(r'^(?:[├└]──|[+`]--) (\S+)$', l.strip('\n'))
                if m:
                    name, _, ver = m.group(1).rpartition('@')
                    if name:
                        objs.append({'kind': 'language-package', 'id': f'npm:{pj}/{name}',
                                     'value': {'version': ver, 'tool': 'npm ls (restricted entry, text)'}})
    for pj in S.names('npmproj:'):
        if S.rc.get(f'npmproj:{pj}') != 0 and S.rc.get(f'npmprojtxt:{pj}') == 0:
            continue
        try:
            deps = json.loads(S.text(f'npmproj:{pj}') or '{}').get('dependencies', {})
            for name, d in deps.items():
                objs.append({'kind': 'language-package', 'id': f'npm:{pj}/{name}',
                             'value': {'version': d.get('version'), 'tool': 'npm ls (project)'}})
        except ValueError as e:
            err(f'npmproj:{pj}', str(e))

    # volatile filesystems
    vm = {}
    for i in S.names('vmount:'):
        f = S.text(f'vmount:{i}').strip('\n').split('\t')
        if len(f) == 2:
            vm[i] = (f[0], f[1])
    vol = {}
    for i in S.names('vlist:'):
        hashes = {}
        for rec in S.sec.get(f'vhash:{i}', b'').split(b'\0'):
            rec = rec.lstrip(b'\n')
            if rec:
                h, _, p = rec.partition(b'  ')
                hashes[p] = h.decode()
        magic = {}
        parts = S.sec.get(f'vmagic:{i}', b'').lstrip(b'\n').split(b'\0')
        for k in range(0, len(parts) - 1, 2):
            magic[parts[k].lstrip(b'\n')] = parts[k + 1]
        f = S.sec.get(f'vlist:{i}', b'').lstrip(b'\n').split(b'\0')
        if S.rc.get(f'vhash:{i}') not in (0, None):
            err(f'vhash:{i}')
        for k in range(0, len(f) - 6, 7):
            y, mode, uid, gid, size, link, path = f[k:k + 7]
            y = y.decode().strip()
            p = path.decode('utf-8', 'surrogateescape')
            kind = {'f': 'vfile', 'd': 'vdir', 'l': 'vsymlink'}.get(y, 'vother')
            mode_i = int(mode.decode() or '0', 8)
            head = bytes.fromhex(magic.get(path, b'').decode() or '')
            ex, reason = exec_of(kind, mode_i, p, head)
            o = {'kind': kind, 'id': p, 'mode': '%04o' % mode_i, 'uid': int(uid), 'gid': int(gid),
                 'size': int(size) if kind == 'vfile' else 0,
                 'sha256': hashes.get(path) if kind == 'vfile' else None,
                 'target': link.decode('utf-8', 'surrogateescape') if kind == 'vsymlink' else None,
                 'exec': ex, 'exec_reason': reason, 'fs': vm.get(i, ('', ''))[0]}
            if kind == 'vother':
                o['type'] = y
            if kind == 'vfile' and path not in hashes:
                errors.append({'kind': 'error', 'id': 'volatile-unread:' + p, 'detail': 'sha256 not read'})
            vol[p] = o  # a nested mount's root replaces the mount point seen from the parent
    objs.extend(vol.values())
    meta['volatile_mounts'] = sorted(v[1] for v in vm.values())
    if S.rc.get('sync') != 0:
        err('sync')
    meta['synced'] = S.rc.get('sync') == 0
    return S, meta, mounts


