# Stored level

class GF:
    def __init__(self, disk, fmt):
        with tempfile.TemporaryFile() as out:
            p = subprocess.Popen(['guestfish', '--listen', '--ro', f'--format={fmt}', '-a', disk],
                                 stdout=subprocess.PIPE, stderr=out, stdin=subprocess.DEVNULL, text=True)
            line = p.stdout.readline()
            p.stdout.close()
            m = re.search(r'GUESTFISH_PID=(\d+)', line)
            if not m:
                p.wait(timeout=60)
                out.seek(0)
                raise RuntimeError('guestfish --listen failed: ' + line + out.read().decode('utf-8', 'replace'))
            p.wait(timeout=60)
        self.pid = m.group(1)

    def __call__(self, *args, check=True):
        p = subprocess.run(['guestfish', f'--remote={self.pid}', '--', *args], capture_output=True, text=True,
                           timeout=7200)
        if check and p.returncode != 0:
            raise RuntimeError(f'guestfish {" ".join(args)}: {p.stderr.strip()}')
        return p.stdout if p.returncode == 0 else None

    def close(self):
        subprocess.run(['guestfish', f'--remote={self.pid}', '--', 'exit'], capture_output=True, timeout=60)


def tar_objects(tarpath, id_of, runtime_of, fsname, images_out, tmpdir):
    """Read a tar produced by guestfish tar-out; yield stored objects. Saves filesystem images found."""
    objs = []
    seen = {}
    with tarfile.open(tarpath, 'r:') as tf:
        for m in tf:
            name = m.name
            if name.startswith('./'):
                name = name[1:]
            elif name == '.':
                name = '/'
            elif not name.startswith('/'):
                name = '/' + name
            if name != '/' and name.endswith('/'):
                name = name.rstrip('/')
            mode = m.mode & 0o7777
            sha = None
            head = b''
            target = None
            typ = None
            size = 0
            if m.isreg():
                kind = 'file'
                size = m.size
                h = hashlib.sha256()
                f = tf.extractfile(m)
                img_fh = None
                first = True
                while True:
                    b = f.read(1 << 20)
                    if not b:
                        break
                    if first:
                        head = b[:65536]
                        first = False
                        it = image_type(head)
                        if it:
                            fd, ipath = tempfile.mkstemp(dir=tmpdir, suffix='.img')
                            img_fh = os.fdopen(fd, 'wb')
                            images_out.append((name, it, ipath))
                    h.update(b)
                    if img_fh:
                        img_fh.write(b)
                if img_fh:
                    img_fh.close()
                sha = h.hexdigest()
                seen[m.name] = (sha, head[:4], size)
            elif m.islnk():
                kind = 'file'
                sha, head, size = seen.get(m.linkname, (None, b'', 0))
            elif m.issym():
                kind = 'symlink'
                target = m.linkname
            elif m.isdir():
                kind = 'dir'
            else:
                kind = 'other'
                typ = {tarfile.CHRTYPE: 'char', tarfile.BLKTYPE: 'block', tarfile.FIFOTYPE: 'fifo'}.get(m.type, 'unknown')
            ex, reason = exec_of(kind, mode, name, head)
            o = {'kind': kind, 'id': id_of(name), 'mode': '%04o' % mode, 'uid': m.uid, 'gid': m.gid, 'size': size,
                 'sha256': sha, 'target': target, 'exec': ex, 'exec_reason': reason, 'fs': fsname, 'fs_path': name}
            if typ:
                o['type'] = typ
                if typ in ('char', 'block'):
                    o['rdev'] = f'{m.devmajor}:{m.devminor}'
            if m.islnk():
                o['hardlink_to'] = id_of('/' + m.linkname.lstrip('./')) if m.linkname.startswith('./') else m.linkname
            rt = runtime_of(name)
            if rt:
                o['runtime'] = rt
            objs.append(o)
    return objs


def join(prefix, path):
    if path == '/':
        return prefix or '/'
    return (prefix.rstrip('/') + path) if prefix not in ('', '/') else path


def take_stored(args, mounts, mount_objs, meta, objs, errors, tmpdir):
    gf = GF(args.disk, args.format)
    try:
        gf('run')
        gf('mkmountpoint', '/p')
        gf('mkmountpoint', '/i')
        gf('mkmountpoint', '/j')
        devices = gf('list-devices').split()
        parts = gf('list-partitions').split()
        fss = {}
        for line in gf('list-filesystems').splitlines():
            d, _, t = line.partition(': ')
            fss[d] = t.strip()
        meta['stored_devices'] = devices
        # the disk itself: partition table and boot code area
        for dev in devices:
            dn = 'disk' if dev == devices[0] else 'disk-' + dev.rsplit('/', 1)[-1]
            pt = gf('part-get-parttype', dev, check=False)
            plist = gf('part-list', dev, check=False) or ''
            extra = []
            if pt and pt.strip() == 'gpt':
                for pn in re.findall(r'part_num: (\d+)', plist):
                    extra.append(f'{pn} type={(gf("part-get-gpt-type", dev, pn, check=False) or "").strip()} '
                                 f'guid={(gf("part-get-gpt-guid", dev, pn, check=False) or "").strip()} '
                                 f'name={(gf("part-get-name", dev, pn, check=False) or "").strip()}')
            text = f'parttype={(pt or "none").strip()}\n{plist}\n' + '\n'.join(extra)
            objs.append({'kind': 'other', 'id': f'@{dn}/partition-table', 'type': 'partition-table', 'mode': None,
                         'uid': None, 'gid': None, 'size': len(text), 'sha256': sha_bytes(text.encode()),
                         'target': None, 'exec': False, 'exec_reason': None, 'value': text})
            bpath = os.path.join(tmpdir, 'bootsector')
            gf('download-offset', dev, bpath, '0', '440')
            with open(bpath, 'rb') as f:
                bs = f.read()
            objs.append({'kind': 'other', 'id': f'@{dn}/boot-code', 'type': 'boot-code', 'mode': None, 'uid': None,
                         'gid': None, 'size': len(bs), 'sha256': sha_bytes(bs), 'target': None,
                         'exec': any(bs), 'exec_reason': 'boot-code' if any(bs) else None})
        # map filesystems to their runtime mounts by UUID (and by device name as a fallback)
        for dev, fstype in sorted(fss.items()):
            m = re.match(r'/dev/[a-z]+?(\d+)$', dev)
            fsname = f'@part{m.group(1)}' if m else '@' + dev.rsplit('/', 1)[-1]
            uuid = (gf('vfs-uuid', dev, check=False) or '').strip()
            label = (gf('vfs-label', dev, check=False) or '').strip()
            rt = [mm for mm in mounts if uuid and (mm.get('uuid') or '') == uuid and mm.get('fstype') != 'squashfs']
            how = 'uuid'
            if not rt and m and not any(mm.get('uuid') for mm in mounts):
                # no UUIDs known in the guest (findmnt absent): the partition number of the mount's source device
                how = 'partition number'
                rt = [mm for mm in mounts if re.match(
                    r'/dev/(?:[sv]d[a-z]+|xvd[a-z]+|nvme\d+n\d+p|mmcblk\d+p)' + m.group(1) + r'(\[.*\])?$',
                    mm.get('source') or '')]
            prefix = None
            aliases = []
            for mm in rt:
                fr = mm.get('fsroot') or '/'
                if fr == '/' and prefix is None:
                    prefix = mm['target']
                aliases.append((fr, mm['target']))
            meta.setdefault('stored_filesystems', []).append(
                {'device': dev, 'name': fsname, 'fstype': fstype, 'uuid': uuid, 'label': label, 'matched_by': how,
                 'runtime_mounts': [{'fsroot': a, 'target': b} for a, b in aliases]})
            if fstype in ('unknown', 'swap', '') or fstype.startswith('LVM'):
                # no mountable filesystem: record the raw content
                h = (gf('checksum-device', 'sha256', dev, check=False) or '').strip()
                size = (gf('blockdev-getsize64', dev, check=False) or '0').strip()
                objs.append({'kind': 'other', 'id': fsname, 'type': 'raw-partition:' + fstype, 'mode': None,
                             'uid': None, 'gid': None, 'size': int(size or 0), 'sha256': h or None, 'target': None,
                             'exec': True, 'exec_reason': 'raw'})
                continue
            idp = prefix if prefix is not None else fsname

            def id_of(path, idp=idp):
                return join(idp, path) if idp.startswith('/') else (idp + path if path != '/' else idp + '/')

            def runtime_of(path, aliases=aliases, prefix=prefix):
                out = []
                for fr, tgt in aliases:
                    if fr == '/' and tgt == prefix:
                        continue
                    if path == fr or path.startswith(fr.rstrip('/') + '/'):
                        out.append(join(tgt, path[len(fr.rstrip('/')):] or '/'))
                return out or None

            r = gf('mount-ro', dev, '/p', check=False)
            if r is None:
                errors.append({'kind': 'error', 'id': f'stored/{fsname}', 'detail': f'mount-ro {dev} failed'})
                continue
            images = []
            t0 = time.time()
            n = walk_fs(gf, '/p', fsname, id_of, runtime_of, images, objs, errors, tmpdir)
            log(f'{fsname} ({fstype}) {n} objects in {time.time() - t0:.1f}s')
            for (ipath, itype, hostcopy) in images:
                open_image(gf, '/p', ipath, itype, hostcopy, id_of(ipath), mount_objs, meta, objs, errors, tmpdir,
                           depth=0)
            gf('umount', '/p', check=False)
    finally:
        gf.close()


def walk_fs(gf, mnt, fsname, id_of, runtime_of, images, objs, errors, tmpdir):
    tarpath = os.path.join(tmpdir, 'fs.tar')
    gf('tar-out', mnt, tarpath, 'numericowner:true')
    found = tar_objects(tarpath, id_of, runtime_of, fsname, images, tmpdir)
    os.unlink(tarpath)
    # completeness: names that tar does not carry (sockets) are taken with lstatns
    lpath = os.path.join(tmpdir, 'find0')
    gf('find0', mnt, lpath)
    with open(lpath, 'rb') as f:
        names = {'/' + n.decode('utf-8', 'surrogateescape').lstrip('/') for n in f.read().split(b'\0') if n}
    os.unlink(lpath)
    have = {o['fs_path'] for o in found}
    for n in sorted(names - have):
        st = gf('lstatns', mnt + n, check=False)
        kv = dict(re.findall(r'(\w+): (-?\d+)', st or ''))
        mode = int(kv.get('st_mode', '0'))
        typ = {0o140000: 'socket', 0o010000: 'fifo', 0o020000: 'char', 0o060000: 'block'}.get(mode & 0o170000)
        if typ is None:
            errors.append({'kind': 'error', 'id': 'stored-not-in-tar:' + id_of(n), 'detail': st or 'lstatns failed'})
            typ = 'unknown'
        o = {'kind': 'other', 'id': id_of(n), 'type': typ, 'mode': '%04o' % (mode & 0o7777),
             'uid': int(kv.get('st_uid', -1)), 'gid': int(kv.get('st_gid', -1)), 'size': 0, 'sha256': None,
             'target': None, 'exec': False, 'exec_reason': None, 'fs': fsname, 'fs_path': n}
        rt = runtime_of(n)
        if rt:
            o['runtime'] = rt
        found.append(o)
    objs.extend(found)
    return len(found)


def open_image(gf, mnt, ipath, itype, hostcopy, image_id, mounts, meta, objs, errors, tmpdir, depth):
    """List the contents of a filesystem image found at ipath (inside the filesystem mounted at mnt)."""
    with open(hostcopy, 'rb') as f:
        h = hashlib.sha256()
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    isha = h.hexdigest()
    # where is it mounted at runtime? exact content of a loop device, else the loop back-file path
    rt_target = None
    how = None
    for o in mounts:
        if o['kind'] != 'mount':
            continue
        v = o['value']
        if v.get('loop_sha256') == isha and (v.get('fsroot') in ('/', None)):
            rt_target, how = o['id'].split('#')[0], 'loop device content sha256'
            break
    if rt_target is None:
        cands = []
        for o in mounts:
            if o['kind'] == 'mount' and o['value'].get('loop_back_file'):
                bf = o['value']['loop_back_file']
                ip = image_id.split('!')[-1]
                if bf == image_id or bf.endswith(ip) or (os.path.basename(bf) == os.path.basename(ip)):
                    cands.append(o['id'].split('#')[0])
        if len(set(cands)) == 1:
            rt_target, how = cands[0], 'loop back-file path'
        elif len(set(cands)) > 1:
            errors.append({'kind': 'error', 'id': 'image-runtime-ambiguous:' + image_id, 'detail': str(cands)})
    meta.setdefault('images', []).append({'id': image_id, 'type': itype, 'sha256': isha, 'runtime_mount': rt_target,
                                          'matched_by': how})
    mp = '/i' if depth == 0 else '/j'
    if depth > 1:
        errors.append({'kind': 'error', 'id': 'image-nesting:' + image_id, 'detail': 'image nested deeper than 2'})
        os.unlink(hostcopy)
        return

    def id_of(path):
        return image_id + '!' + path

    def runtime_of(path):
        if rt_target is None:
            return None
        return [join(rt_target, path)]

    images = []
    r = gf('mount-loop', mnt + ipath, mp, check=False)
    if r is None:
        if itype == 'squashfs' and shutil.which('unsquashfs'):
            n = unsquash(hostcopy, image_id, id_of, runtime_of, objs, errors, tmpdir)
            log(f'image {image_id} ({itype}, unsquashfs) {n} objects')
        else:
            errors.append({'kind': 'error', 'id': 'image-unopened:' + image_id, 'detail': f'mount-loop failed ({itype})'})
        os.unlink(hostcopy)
        return
    os.unlink(hostcopy)
    n = walk_fs(gf, mp, image_id, id_of, runtime_of, images, objs, errors, tmpdir)
    log(f'image {image_id} ({itype}, mount-loop) {n} objects, runtime mount {rt_target}')
    for (p2, t2, c2) in images:
        open_image(gf, mp, p2, t2, c2, id_of(p2), mounts, meta, objs, errors, tmpdir, depth + 1)
    gf('umount', mp, check=False)


def unsquash(img, image_id, id_of, runtime_of, objs, errors, tmpdir):
    """Fallback when the appliance cannot mount the image: list with unsquashfs -lln, hash an extraction."""
    p = subprocess.run(['unsquashfs', '-lln', '-d', '', img], capture_output=True, text=True,
                       errors='surrogateescape')
    d = tempfile.mkdtemp(dir=tmpdir)
    subprocess.run(['unsquashfs', '-f', '-no-xattrs', '-d', d, img], capture_output=True)
    n = 0
    for line in p.stdout.splitlines():
        m = re.match(r'([-dlcbps])([rwxsStT-]{9})\s+(\d+)/(\d+)\s+(\S+(?:,\s*\d+)?)\s+\S+\s+\S+\s(.*)$', line)
        if not m:
            continue
        t, perm, uid, gid, size, rest = m.groups()
        mode = 0
        for i, c in enumerate(perm):
            if c not in '-ST':
                mode |= 1 << (8 - i)
        if perm[2] in 'sS':
            mode |= 0o4000
        if perm[5] in 'sS':
            mode |= 0o2000
        if perm[8] in 'tT':
            mode |= 0o1000
        target = None
        name = rest
        if t == 'l':
            name, _, target = rest.partition(' -> ')
        name = name if name.startswith('/') else '/' + name
        if name != '/':
            name = name.rstrip('/')
        kind = {'-': 'file', 'd': 'dir', 'l': 'symlink'}.get(t, 'other')
        sha, head = None, b''
        if kind == 'file':
            fp = d + name
            try:
                os.chmod(fp, 0o600)
                with open(fp, 'rb') as f:
                    hh = hashlib.sha256()
                    head = f.read(65536)
                    hh.update(head)
                    for b in iter(lambda: f.read(1 << 20), b''):
                        hh.update(b)
                sha = hh.hexdigest()
            except OSError as e:
                errors.append({'kind': 'error', 'id': 'unsquash-unread:' + id_of(name), 'detail': str(e)})
        ex, reason = exec_of(kind, mode, name, head)
        o = {'kind': kind, 'id': id_of(name), 'mode': '%04o' % mode, 'uid': int(uid), 'gid': int(gid),
             'size': int(size) if kind == 'file' else 0, 'sha256': sha, 'target': target, 'exec': ex,
             'exec_reason': reason, 'fs': image_id, 'fs_path': name}
        rt = runtime_of(name)
        if rt:
            o['runtime'] = rt
        objs.append(o)
        n += 1
    subprocess.run(['chmod', '-R', 'u+rwx', d], capture_output=True)
    shutil.rmtree(d, ignore_errors=True)
    return n


PART_RE = re.compile(r'/dev/(?:[sv]d[a-z]+|xvd[a-z]+|nvme\d+n\d+p|mmcblk\d+p)(\d+)$')


def owner_filter(stored, mount_objs, meta):
    """Keep a runtime path of a stored object only if the object is what is in force at that path.

    At runtime a path belongs to one mount: the one with the longest target containing the path (of stacked mounts on
    one target, the last in the kernel's order). A stored object is in force at the path only if that mount shows the
    object's own filesystem (partition, or image by the SHA256 of the loop device) at the object's own path. Without
    this, a mount point hidden under a bind mount (for example an empty file in the data partition under a file bound
    from the root image) would be taken for the object in force. Returns the number of runtime paths dropped."""
    ms = []
    for i, o in enumerate(mount_objs):
        v = o.get('value') or {}
        idents = set()
        if v.get('loop_sha256'):
            idents.add(('img', v['loop_sha256']))
        else:
            m = PART_RE.match((v.get('source') or '').split('[')[0])
            if m:
                idents.add(('part', m.group(1)))
            if v.get('uuid'):
                idents.add(('uuid', v['uuid']))
        ms.append((o['id'].split('#')[0], v.get('fsroot') or '/', idents, i))
    if not ms:
        return 0
    fs_ident = {}
    for f in meta.get('stored_filesystems', []):
        s = set()
        m = re.match(r'@part(\d+)$', f.get('name') or '')
        if m:
            s.add(('part', m.group(1)))
        if f.get('uuid'):
            s.add(('uuid', f['uuid']))
        fs_ident[f.get('name')] = s
    for im in meta.get('images', []):
        if im.get('sha256'):
            fs_ident[im['id']] = {('img', im['sha256'])}
    cache = {}

    def owner(path):
        if path not in cache:
            best = None
            for w in ms:
                tgt, i = w[0], w[3]
                if path == tgt or path.startswith(tgt.rstrip('/') + '/'):
                    if best is None or (len(tgt), i) > (len(best[0]), best[3]):
                        best = w
            cache[path] = best
        return cache[path]

    changed = 0
    for o in stored:
        if 'fs_path' not in o or o.get('fs') not in fs_ident:
            continue
        mine = fs_ident[o['fs']]
        mounts_of_fs = [w for w in ms if w[2] & mine]
        if not mounts_of_fs:
            continue  # the filesystem is not mounted at runtime (or not identifiable): leave as found
        p = os.path.normpath(o['fs_path'])
        keep = []
        for w in mounts_of_fs:
            tgt, fr = w[0], os.path.normpath(w[1])
            if p == fr:
                rp = tgt
            elif fr == '/' or p.startswith(fr + '/'):
                rest = p if fr == '/' else p[len(fr):]
                rp = os.path.normpath(tgt.rstrip('/') + rest) if tgt != '/' else rest
            else:
                continue
            if owner(rp) is w and rp not in keep:
                keep.append(rp)
        old = o.get('runtime') or []
        if sorted(old) != sorted(keep):
            changed += 1
        if keep:
            o['runtime'] = keep
            o.pop('shadowed', None)
        else:
            o.pop('runtime', None)
            if old or mounts_of_fs:
                o['shadowed'] = True
    return changed


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('--disk', required=True)
    ap.add_argument('--format', default='qcow2')
    ap.add_argument('--ssh-port', type=int)
    ap.add_argument('--ssh-host', default='127.0.0.1')
    ap.add_argument('--ssh-key')
    ap.add_argument('--user')
    ap.add_argument('--root-cmd', default='sudo -n')
    ap.add_argument('--raw', help='also write the raw output of the collector to this file (diagnosis)')
    ap.add_argument('--firewall-fallback', help='read-only command run as root in the guest that prints the native '
                    'nft text, used only if `nft list ruleset` is refused (e.g. "confos rules")')
    ap.add_argument('--out', required=True)
    ap.add_argument('--timeout', type=int, default=1800)
    args = ap.parse_args()
    os.makedirs(args.out, exist_ok=True)
    tmpdir = tempfile.mkdtemp(prefix='inv-', dir=args.out)
    force, stored, errors = [], [], []
    meta = {'tool': 'inventory', 'disk': os.path.basename(args.disk), 'started_utc':
            time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
    mounts = []
    status = 0
    try:
        if args.ssh_port:
            if not (args.ssh_key and args.user):
                ap.error('--ssh-port needs --ssh-key and --user')
            _, m2, mounts = take_force(args, force, errors)
            meta.update(m2)
            meta['stored_level_note'] = (
                'stored level read while the machine runs, after sync in the guest, from the live disk opened '
                'read-only with libguestfs (--ro); libguestfs documents this as safe but the view may be '
                'inconsistent if the guest writes during the read')
        else:
            meta['force_level'] = 'not taken (no --ssh-port); stored level only'
        t0 = time.time()
        mount_objs = [o for o in force if o['kind'] == 'mount']
        take_stored(args, mounts, mount_objs, meta, stored, errors, tmpdir)
        log(f'stored level read in {time.time() - t0:.1f}s, {len(stored)} objects')
        if mount_objs:
            n = owner_filter(stored, mount_objs, meta)
            meta['runtime_paths'] = ('each runtime path is assigned to the stored object that the owning mount of the '
                                     'path shows (longest mount target; last of stacked mounts); objects that no mount '
                                     f'shows are marked shadowed; {n} objects changed')
            log(f'runtime paths by owning mount: {n} objects changed, '
                f'{sum(1 for o in stored if o.get("shadowed"))} shadowed')
    except Exception as e:
        errors.append({'kind': 'error', 'id': 'inventory/fatal', 'detail': f'{type(e).__name__}: {e}'})
        log(f'FATAL {type(e).__name__}: {e}')
        status = 2
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    meta['finished_utc'] = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    meta['counts'] = {'stored': len(stored), 'force': len(force), 'errors': len(errors)}
    force.append({'kind': 'meta', 'id': 'meta', 'value': meta})
    # errors of the stored level go with the stored objects, others with the force level
    for e in errors:
        (stored if e['id'].startswith(('stored', 'image', 'unsquash', 'inventory/fatal')) else force).append(e)
    jdump(os.path.join(args.out, 'stored.jsonl'), stored)
    for o in force:
        if o.get('kind') == 'meta' and isinstance(o.get('value'), dict):
            o['value']['non_utf8_strings_in_stored'] = NON_UTF8[0]
    jdump(os.path.join(args.out, 'force.jsonl'), force)
    ex = [o for o in stored + force if o.get('exec') is True]
    jdump(os.path.join(args.out, 'executables.jsonl'), ex)
    log(f'wrote {args.out}: stored {len(stored)}, force {len(force)}, executables {len(ex)}, errors {len(errors)}')
    sys.exit(status)


if __name__ == '__main__':
    main()
