#!/usr/bin/env python3
"""Inventory of a whole machine at both levels of Paper 3, Section 4.2 (format: FORMATS.md, "Inventory").

Force level: asked over SSH with the standard tools of the system (one shell script sent to the guest's bash on
standard input, run as superuser through --root-cmd), including every object on a volatile filesystem (tmpfs, ramfs,
devtmpfs; device nodes of devtmpfs are not listed).
Stored level: the disk image read from outside with libguestfs opened read-only, every filesystem of every partition,
every object with sha256/mode/uid/gid, and the contents of every filesystem image file found on the disk.

Nothing of ConfOS is read to decide anything. The dpkg database is read only through dpkg-query as the answer of the
standard tool to "which packages are in force"; it is never used to decide which files belong to a package.

Python 3 standard library only. Runs on the host that runs the virtual machine.
"""
import argparse
import base64
import hashlib
import ipaddress
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time

EXEC_SUFFIXES = ('.sh', '.bash', '.py', '.pl', '.rb', '.js', '.lua', '.desktop', '.service', '.timer', '.socket',
                 '.path')
EXEC_NAMES = ('.bashrc', '.profile', '.bash_profile', '.bash_login', '.bash_logout')
VOLATILE_FS = ('tmpfs', 'ramfs', 'devtmpfs')

# ----------------------------------------------------------------------------------------------------------------
# Guest collector. Sent to the guest's bash on standard input; prints sections delimited by a per-run token, on
# standard output and (for the attribution of messages) on standard error. It writes nothing on the machine.
COLLECTOR = r'''
T="$1"
FWALT="${2:-}"   # base64 of a read-only command printing the native nft text, used only when nft itself is refused
export LC_ALL=C PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PYTHONDONTWRITEBYTECODE=1 SYSTEMD_PAGER= SYSTEMD_COLORS=0 npm_config_logs_max=0 npm_config_update_notifier=false
B() { printf '\n@@%s BEGIN %s@@\n' "$T" "$1"; printf '\n@@%s BEGIN %s@@\n' "$T" "$1" >&2; }
E() { printf '\n@@%s END %s %s@@\n' "$T" "$1" "$2"; printf '\n@@%s END %s %s@@\n' "$T" "$1" "$2" >&2; }
run() { local n="$1"; shift; B "$n"; "$@"; E "$n" "$?"; }
have() { command -v "$1" >/dev/null 2>&1; }
# portable listing: works with GNU and BusyBox find/stat/sha256sum (no -printf, no sha256sum -z)
hashlist() {  # NUL-separated paths on stdin -> "SHA256  PATH\0" for regular files
  local p h
  while IFS= read -r -d '' p; do
    [ -f "$p" ] && [ ! -L "$p" ] || continue
    if h=$(sha256sum < "$p" 2>/dev/null); then printf '%s  %s\0' "${h%% *}" "$p"; else printf 'sha256 unreadable: %s\n' "$p" >&2; fi
  done
}
hashfiles() {
  local ex=() p
  for p in "$@"; do [ -e "$p" ] && ex+=("$p"); done
  [ ${#ex[@]} -eq 0 ] && return 0
  find "${ex[@]}" -type f -print0 | hashlist
}
vlist() {  # $1 mount point, $2 fstype -> per object: TYPE MODE UID GID SIZE LINK PATH, NUL-separated
  local p y s l ft="$2"
  find "$1" -xdev -print0 | while IFS= read -r -d '' p; do
    if [ -L "$p" ]; then y=l; elif [ -d "$p" ]; then y=d; elif [ -f "$p" ]; then y=f; elif [ -p "$p" ]; then y=p
    elif [ -S "$p" ]; then y=s; elif [ -b "$p" ]; then y=b; elif [ -c "$p" ]; then y=c; else y=u; fi
    if [ "$ft" = devtmpfs ] && { [ $y = b ] || [ $y = c ]; }; then continue; fi
    s=$(stat -c '%a %u %g %s' "$p" 2>/dev/null) || { printf 'stat failed: %s\n' "$p" >&2; continue; }
    l=; [ $y = l ] && l=$(readlink "$p")
    set -- $s
    printf '%s\0%s\0%s\0%s\0%s\0%s\0%s\0' "$y" "$1" "$2" "$3" "$4" "$l" "$p"
  done
}
vhash() { find "$1" -xdev -type f -print0 | hashlist; }
vmagic() {
  local p
  find "$1" -xdev -type f -print0 | while IFS= read -r -d '' p; do
    printf '%s\0' "$p"; head -c 4 "$p" 2>/dev/null | od -An -v -tx1 | tr -d ' \n'; printf '\0'
  done
}
db() { if have getent; then getent "$1"; else cat "/etc/$1"; fi; }
f1() { local a b; while read -r a b; do printf '%s\n' "$a"; done; }
f2() { local a b c; while read -r a b c; do printf '%s\n' "$b"; done; }
accounts() { db passwd | cut -d: -f1; }
homes() { db passwd | while IFS=: read -r n p u g c h s; do printf '%s\t%s\t%s\n' "$n" "$u" "$h"; done; }
mounts_tf() {
  if have findmnt; then findmnt -rn -o TARGET,FSTYPE; return; fi
  local F k
  while read -r -a F; do for ((k=6; k<${#F[@]}; k++)); do [ "${F[k]}" = - ] && break; done; printf '%s %s\n' "${F[4]}" "${F[k+1]}"; done < /proc/self/mountinfo
}

run meta_boot cat /proc/sys/kernel/random/boot_id
run meta_kernel uname -r
run meta_time date -u +%Y-%m-%dT%H:%M:%SZ
run meta_session cat /proc/self/sessionid
run meta_hostname cat /proc/sys/kernel/hostname
run meta_pid1 readlink /proc/1/exe
run meta_cmdline cat /proc/cmdline

run dpkg dpkg-query -W -f '${Package}\t${Architecture}\t${Version}\t${db:Status-Abbrev}\n'

ssc() { systemctl "$@"; }
usc() { local u="$USC" id; id=$(id -u "$u"); runuser -u "$u" -- env XDG_RUNTIME_DIR=/run/user/$id DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$id/bus systemctl --user "$@"; }
unitnames() {
  { "$1" list-unit-files --no-legend --full --no-pager 2>/dev/null | f1
    "$1" list-units --all --no-legend --full --no-pager --plain 2>/dev/null | f1
