    if [ -d "$h/.local/share/flatpak" ]; then run "flatpak:$n" runuser -u "$n" -- flatpak list --user --all --columns=application,version,origin,installation,active,branch,arch; fi
  done
else
  run flatpak flatpak --version
fi

pythons() { find /usr /opt /root /home -xdev \( -type f -o -type l \) -name 'python3*' 2>/dev/null | while IFS= read -r p; do [[ "$p" =~ /bin/python3(\.[0-9]+)?$ ]] && printf '%s\n' "$p"; done | sort; }
B pythons; pythons; E pythons 0
# A Python of a Flatpak runtime or application tree (.../files/bin/python3) runs in its declared context: with the
# loader and libraries of that tree (outside it the host loader finds no libpython of the tree)
pyctx() {
  case "$1" in
    */files/bin/*)
      local r="${1%/bin/*}" ld
      for ld in "$r/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" "$r/lib64/ld-linux-x86-64.so.2" "$r/lib/ld-linux-x86-64.so.2"; do
        [ -f "$ld" ] || continue
