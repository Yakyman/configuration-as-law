  [ -z "$n" ] && return 0
  local P=Id,LoadState,UnitFileState,ActiveState,SubState,FragmentPath,SourcePath,Transient,ControlGroup,DropInPaths
  # no `--` (a system may expose only a restricted read-only form of systemctl); if the batch is refused, one by one
  "$1" show -p "$P" $n 2>/dev/null && return 0
