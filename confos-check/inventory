i=0
mounts_tf | while read -r t f; do
  case "$f" in tmpfs|ramfs|devtmpfs) ;; *) continue;; esac
  t=$(printf '%b' "$t")
  run "vmount:$i" printf '%s\t%s\n' "$f" "$t"
  run "vlist:$i" vlist "$t" "$f" < /dev/null
  run "vhash:$i" vhash "$t" < /dev/null
  run "vmagic:$i" vmagic "$t" < /dev/null
