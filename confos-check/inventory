}
# accounts whose user manager runs (also without logind or linger)
umanagers() { local d; for d in /proc/[0-9]*; do case "$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)" in *systemd\ --user*) stat -c %U "$d" 2>/dev/null;; esac; done | sort -u; }
users=
if [ -d /run/systemd/system ]; then
run units_files ssc list-unit-files --no-legend --full --no-pager
run units_list ssc list-units --all --no-legend --full --no-pager --plain
run units_show unitshow ssc
users=$( { loginctl list-users --no-legend 2>/dev/null | f2; ls /var/lib/systemd/linger 2>/dev/null; umanagers; } | sort -u)
else
run nosystemd readlink /proc/1/exe
fi
B usermanagers
for u in $users; do printf '%s\n' "$u"; done
E usermanagers 0
B linger; ls /var/lib/systemd/linger 2>/dev/null; E linger 0
for u in $users; do
  USC="$u"
  run "uunits_files:$u" usc list-unit-files --no-legend --full --no-pager
  run "uunits_list:$u" usc list-units --all --no-legend --full --no-pager --plain
  run "uunits_show:$u" unitshow usc
done

procs() {
  local d p st
  for d in /proc/[0-9]*; do
    p=${d#/proc/}
    st=$(cut -d')' -f2- "$d/stat" 2>/dev/null) || continue
    set -- $st
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$(readlink "$d/exe" 2>/dev/null)" "$(sed -n 's/^0:://p' "$d/cgroup" 2>/dev/null)" \
      "$2" "$(stat -c %u "$d" 2>/dev/null)" "$(tr -d '\n' < "$d/comm" 2>/dev/null)" "$(tr '\0\t\n' '   ' < "$d/cmdline" 2>/dev/null)"
  done
}
sockinodes() { local d l; for d in /proc/[0-9]*/fd/*; do l=$(readlink "$d" 2>/dev/null) || continue; case "$l" in socket:*) l=${d#/proc/}; printf '%s\t%s\n' "${l%%/*}" "$(readlink "$d")";; esac; done; }
# containers first: rootless podman leaves its pause process running after its first call, so the process list
# below already contains what the podman queries of any inventory leave behind (two inventories of one
# machine stay comparable; the process is still reported, it is in force)
if have podman; then
  if [ -d /var/lib/containers ]; then
    run podps:root podman ps -a --format json
    run podimg:root podman images --format json
  fi
  # every ordinary account (UID 1000..60000), also when its image store is not below its home directory
  homes | while IFS=$'\t' read -r n u h; do
    if [ "$u" != 0 ] && { [ -d "$h/.local/share/containers" ] || { [ "$u" -ge 1000 ] && [ "$u" -le 60000 ]; }; }; then
      run "podps:$n" runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman ps -a --format json
      if ! runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman ps -a --format json >/dev/null 2>&1; then
        run "podpsplain:$n" runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman ps -a
      fi
      run "podimg:$n" runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman images --format json
      if ! runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman images --format json >/dev/null 2>&1; then
        # only plain `podman images` and `podman image inspect NAME` exposed: names from the first, ids from the second
        run "podimgplain:$n" runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman images
        for ref in $(runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman images 2>/dev/null | while read -r repo tag rest; do [ "$repo" = REPOSITORY ] || [ "$repo" = '<none>' ] || [ -z "$tag" ] || printf '%s:%s\n' "$repo" "$tag"; done); do
          run "podinspect:$n:$ref" runuser -u "$n" -- env XDG_RUNTIME_DIR=/run/user/$u HOME="$h" podman image inspect "$ref"
        done
      fi
    fi
  done
else
  run podman podman --version
fi
run ps ps -ww -e -o pid=,ppid=,user:64=,args=
run procexe procs

run passwd db passwd
run group db group
shadow() { db shadow | while IFS=: read -r n h r; do printf '%s\t%s\n' "$n" "$(printf %s "$h" | sha256sum | cut -d' ' -f1)"; done; }
run shadow shadow
if have sudo; then
  for n in $(accounts); do run "sudol:$n" sudo -n -l -U "$n"; done
else
