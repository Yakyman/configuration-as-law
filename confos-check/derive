#!/usr/bin/env python3
"""derive: from a declaration alone, derive every object that it requires.

Usage: derive --declaration DIR_OR_FILE --cache DIR --out derived.jsonl
              [--components components.txt] [--arch amd64]

Rule (fifth paper, Table 9, Understanding): besides the declaration, the derivation reads only the packages that
its lines name, in the release that the line names, or, for a component of the base, in the release committed
for the components; any other package is not read. Nothing produced by the implementation on a machine is read,
and no program of the implementation is run.

Every file opened, every directory listed, every program started and every URL fetched is written to
CACHE/derive-reads.log (one JSON object per line) by an audit hook, so that a test can prove what was read.

Exit status: 0 when a derivation was written and no `error` object is in it; 2 otherwise.
"""
# All modules are imported before the audit hook is installed, so that imports do not appear as reads.
import argparse
import datetime
import hashlib
import io
